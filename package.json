{
  "name": "csv-importer",
  "version": "1.0.0",
  "description": "CLI tool for importing CSV files to various databases",
  "main": "dist/index.js",
  "bin": {
    "csv-import": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "dev:large": "node --max-old-space-size=4096 -r ts-node/register src/index.ts",
    "start": "node dist/index.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": ["csv", "import", "database", "cli"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "commander": "^11.1.0",
    "dotenv": "^16.3.1",
    "papaparse": "^5.4.1",
    "mssql": "^10.0.2",
    "pg": "^8.11.3",
    "@clickhouse/client": "^0.2.10",
    "mongodb": "^6.3.0",
    "chalk": "^4.1.2",
    "ora": "^5.4.1",
    "cli-progress": "^3.12.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@types/papaparse": "^5.3.14",
    "@types/mssql": "^9.1.5",
    "@types/pg": "^8.10.9",
    "@types/cli-progress": "^3.11.5",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2"
  }
}