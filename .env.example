# CSV Importer Environment Configuration

# =============================================================================
# SQL Server (MSSQL)
# =============================================================================
# Local SQL Server with SQL Authentication
MSSQL_CONNECTION_STRING=Server=localhost,1433;Database=testdb;User Id=sa;Password=YourStrong@Passw0rd;Encrypt=true;TrustServerCertificate=true

# Alternative formats:
# Windows Authentication: Server=localhost;Database=testdb;Trusted_Connection=true;
# Azure SQL: Server=myserver.database.windows.net;Database=mydb;User Id=admin;Password=pass;

# =============================================================================
# PostgreSQL
# =============================================================================
# Local PostgreSQL
POSTGRES_CONNECTION_STRING=postgresql://postgres:postgres@localhost:5432/testdb

# Alternative formats:
# With schema: postgresql://user:pass@localhost:5432/mydb?schema=public
# Cloud (Heroku): postgres://user:pass@host:5432/dbname
# Cloud (AWS RDS): postgresql://admin:pass@mydb.123456.us-east-1.rds.amazonaws.com:5432/postgres

# =============================================================================
# ClickHouse
# =============================================================================
# Local ClickHouse
CLICKHOUSE_CONNECTION_STRING=http://default:@localhost:8123/default

# With password:
# CLICKHOUSE_CONNECTION_STRING=http://default:mypassword@localhost:8123/default

# Cloud ClickHouse:
# CLICKHOUSE_CONNECTION_STRING=https://user:password@abc123.clickhouse.cloud:8443/default

# =============================================================================
# MongoDB
# =============================================================================
# Local MongoDB without authentication
MONGODB_CONNECTION_STRING=mongodb://localhost:27017/testdb

# Local MongoDB with authentication
# MONGODB_CONNECTION_STRING=mongodb://admin:password@localhost:27017/testdb?authSource=admin

# MongoDB Atlas (Cloud):
# MONGODB_CONNECTION_STRING=mongodb+srv://username:password@cluster0.abc123.mongodb.net/mydb?retryWrites=true&w=majority

# Docker MongoDB:
# MONGODB_CONNECTION_STRING=mongodb://root:example@localhost:27017/testdb?authSource=admin

# Replica Set:
# MONGODB_CONNECTION_STRING=mongodb://user:pass@host1:27017,host2:27017,host3:27017/mydb?replicaSet=rs0